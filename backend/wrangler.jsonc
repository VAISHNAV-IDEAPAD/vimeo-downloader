{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vimeo-fetch",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-16",
  "workers_dev": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "secrets": {
    "required": ["VIMEO_ACCESS_TOKEN"]
  }
}